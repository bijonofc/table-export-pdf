{
  "name": "@bijon059/table-export-pdf",
  "version": "1.0.0",
  "description": "Framework-agnostic helpers to export an array-of-rows table to CSV and to a print-quality PDF (with repeating headers, page breaks and page numbers). Works in any browser project; drop-in for Vue 3.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bijonofc/table-export-pdf.git"
  },
  "homepage": "https://github.com/bijonofc/table-export-pdf#readme",
  "bugs": {
    "url": "https://github.com/bijonofc/table-export-pdf/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/table-export-pdf.umd.js",
  "module": "dist/table-export-pdf.es.js",
  "exports": {
    ".": {
      "import": "./dist/table-export-pdf.es.js",
      "require": "./dist/table-export-pdf.umd.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "pdf",
    "csv",
    "export",
    "table",
    "html2pdf",
    "jspdf",
    "report",
    "vue",
    "vue3"
  ],
  "peerDependencies": {
    "html2pdf.js": ">=0.10.0"
  },
  "peerDependenciesMeta": {
    "html2pdf.js": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "html2pdf.js": "^0.10.1",
    "highlight.js": "^11.9.0"
  },
  "license": "MIT"
}
