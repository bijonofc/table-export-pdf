{
  "name": "@bijon059/table-export-pdf",
  "version": "1.0.0",
  "description": "Framework-agnostic helpers to export an array-of-rows table to CSV and to a print-quality PDF (with repeating headers, page breaks and page numbers). Works in any browser project; drop-in for Vue 3.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Bijon Munshi",
    "url": "https://github.com/bijonofc"
  },
  "url": "https://github.com/bijonofc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bijonofc/table-export-pdf.git"
  },
  "homepage": "https://github.com/bijonofc/table-export-pdf#readme",
  "bugs": {
    "url": "https://github.com/bijonofc/table-export-pdf/issues"
  },
  "keywords": [
     "pdf",
  "csv",
  "table",
  "export",
  "table-export",
  "pdf-export",
  "csv-export",
  "vue",
  "vue3",
  "javascript",
  "typescript",
  "browser",
  "html2pdf",
  "jspdf"
  ],
  "sideEffects": false,
  "main": "./dist/table-export-pdf.umd.js",
  "module": "./dist/table-export-pdf.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/table-export-pdf.umd.js",
  "jsdelivr": "./dist/table-export-pdf.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/table-export-pdf.es.js",
      "require": "./dist/table-export-pdf.umd.js",
      "default": "./dist/table-export-pdf.es.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "html2pdf.js": ">=0.10.0"
  },
  "peerDependenciesMeta": {
    "html2pdf.js": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:js && npm run build:types",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.json",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "highlight.js": "^11.9.0",
    "html2pdf.js": "^0.10.1",
    "typescript": "^6.0.3",
    "vite": "^5.4.0"
  },
  "funding": {
  "type": "github",
  "url": "https://github.com/sponsors/bijonofc"
}
}
